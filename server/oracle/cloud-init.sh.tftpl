#!/bin/bash
# Generated by Terraform. Runs once on first boot.
set -euo pipefail
exec > >(tee -a /var/log/shieldvpn-install.log) 2>&1
mkdir -p /opt/shieldvpn/src
echo '${install_b64}' | base64 -d > /opt/shieldvpn/src/install.sh
echo '${provision_b64}' | base64 -d > /opt/shieldvpn/src/provision.py
chmod +x /opt/shieldvpn/src/install.sh
SHIELD_TOKEN='${token}' \
SHIELD_TLS_CERT_B64='${cert_b64}' \
SHIELD_TLS_KEY_B64='${key_b64}' \
SHIELD_NAME='${server_name}' \
SHIELD_CC='${country_code}' \
SHIELD_WG_PORT='${wg_port}' \
  /opt/shieldvpn/src/install.sh
